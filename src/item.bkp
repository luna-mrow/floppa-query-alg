#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#include "../headers/item.h"
#include "../headers/macros.h"

static const int NASA_TEMPLATE[] = {
  STRING, STRING, DATA, INT,
  INT, FLOAT, FLOAT, FLOAT,
  INT, STRING, STRING, FLOAT,
  INT, STRING, STRING, STRING,
  FLOAT, FLOAT, FLOAT, FLOAT
};

typedef struct campo_ {
  int tipo;
  union {
    //union compartilha espaço, e todos os ponteiros ocupam o mesmo tanto
    //ao adicionar isso, deixa o free() e outras ações generalizadas mais fáceis
    //eg. free(campo->dado.ptr); if (campo->dado.ptr == NULL); etc..
    void *ptr;
    char *string;
    int *int;
    float *float;
    bool *bool;
  } dado;
};

struct template_ {
  int num_campos;
  char** nomes;
  int* tipos;
};

struct item_ {
  int id;
  CAMPO *campos;
};

CAMPO* campo_string_criar(char *string) {
  CAMPO *campo = (CAMPO*) malloc(sizeof(CAMPO));
  if (campo == NULL) return NULL;

  size_t len = strlen(string);
  //no csv, um campo pode não ter valor, isso vai ser indicado com NULL*
  if (len == 0) campo->dado.string = NULL;
  else {
    campo->dado.string = (char*) malloc(sizeof(char) * (len + 1));
    if (campo->dado.string == NULL) return NULL;

    strcpy(campo->dado.string, string);
  }
  campo->tipo = STRING;

  return campo;
}

CAMPO* campo_int_criar(int *num) {
  CAMPO *campo = (CAMPO*) malloc(sizeof(CAMPO));
  if (campo == NULL) return NULL;

  //*refira ao campo_string_criar
  if (num == NULL) campo->dado.int = NULL;
  else {
    campo->dado.int = (int*) malloc(sizeof(int));
    if (campo->dado.int == NULL) return NULL;

    campo->dado.int = *num;
  }
  campo->tipo = INT;

  return campo;
}

CAMPO* campo_float_criar(float *num) {
  CAMPO *campo = (CAMPO*) malloc(sizeof(CAMPO));
  if (campo == NULL) return NULL;

  //*refira ao campo_string_criar
  if (num == NULL) campo->dado.float = NULL;
  else {
    campo->dado.float = (float*) malloc(sizeof(float));
    if (campo->dado.float == NULL) return NULL;

    campo->dado.float = *num;
  }
  campo->tipo = FLOAT;

  return campo;
}

CAMPO* campo_data_criar(DATA *data) {
  //para fazer depois
}

void campo_apagar(CAMPO **campo) {
  if (campo == NULL || *campo == NULL) return;

  if ((*campo)->dado.ptr != NULL) free((*campo)->dado.ptr);
  free(*campo);
  *campo = NULL;
}

TEMPLATE* template_criar(FILE **fptr, int dataset) {
  if (fptr == NULL || *fptr == NULL) return NULL;
  
  TEMPLATE *template = (TEMPLATE*) malloc(sizeof(TEMPLATE));
  if (template == NULL) return NULL;

  int num_campos = 0, *tipos, ch;

  switch (dataset) {
    case NASA:
      num_campos = NUM_CAMPOS_NASA;
      tipos = (int*) malloc(sizeof(int) * num_campos);
      //copia o conteúdo ao invés de referenciar o vetor constante para o free() ser possível depois
      for (int i = 0; i < num_campos; i++) tipos[i] = NASA_TEMPLATE[i];
      break;
    /*case ANCINE:
      num_campos = NUM_CAMPOS_ANCINE;
      tipos = (int*) malloc(sizeof(int) * num_campos);
      for (int i = 0; i < num_campos; i++) tipos[i] = ANCINE_TEMPLATE[i];
      break;*/
    default:
      while ((ch = fgetc(fptr)) != '\n' && ch != EOF) {
        if (ch == ',') num_campos++;
      }
  }
}

int item_get_id(ITEM* item) {
  return item != NULL ? item->id : -1;
}
